# ============================================================
# WorkBand Backend - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your setup.
# All values here override the hardcoded defaults in main.py.
# ============================================================

# --- Server ---
PORT=8001
HOST=0.0.0.0

# --- SQLite Relational Database ---
SAFETY_DB_PATH=safety_band.db
DEVICE_STALE_SECONDS=15

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- InfluxDB Time-Series Database ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=9dfm-xr7xtnG7OBlrPGDW0ffVaJk54V_SeIgjfyHbhiSCjQcGdQhWEj9jOQmEKXGOJF7Xi71dJ04Szjexy1Dug==
INFLUX_ORG=VIT
INFLUX_BUCKET=IoT

# --- Physiological Alert Thresholds ---
HEART_MIN=45
HEART_MAX=130
SPO2_MIN=90
TEMP_MAX=38
